{
  "manifest_version": 3,
  "name": "Aetheria Market+ (ตลาด+)",
  "version": "0.2.0",
  "description": "ค้นหาไอเทมตลาดกลางตามความสามารถ (attributes/affixes) + ซื้อ/รับของได้ทันที",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.aetheria-online.in.th/*", "https://aetheria-online.in.th/*"],
      "js": ["core.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "market-plus@lumivara.online",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
