# ============================================================
#  lumivaraonline / Aetheria — .gitignore
#
#  NOTE: ignore rules only apply to UNTRACKED files. For anything
#  already committed, untrack it without deleting from disk:
#      git rm -r --cached --ignore-unmatch <path>
#
#  NOTE: keep comments on their OWN lines — gitignore does not
#  support trailing comments after patterns.
# ============================================================

# ── Secrets & live state — never commit ─────────────────────
# live guest/account session token written by the testbot:
aetheria/testbot/out/session.json
# safety net for any future session files:
**/session.json
# command-center server state: bot accounts + passwords (store.json), bots/*, cc.log:
aetheria/command-center/data/

# ── Node ────────────────────────────────────────────────────
node_modules/

# ── Runtime output / logs / caches ──────────────────────────
# spike/session jsonl dumps:
aetheria/out/
# bundle-extraction captures:
aetheria/out-grep/
# bot run logs, snapshots, run-state:
aetheria/testbot/out/
# downloaded package tarball cache:
aetheria/testbot/.tmpvp/
# updater test scratch:
aetheria/market-tool/out-grep/
# signed .xpi output from web-ext:
aetheria/market-tool/web-ext-artifacts/
*.log

# ── Market+ build output — regenerated by `node build.mjs` ──
aetheria/market-tool/dist/
aetheria/market-tool/aetheria-market-plus.user.js

# ── Mirrored game files (downloaded, large, third-party) ────
# ~2.6 MB game bundle + styles + pages/headers/scans:
aetheria/index-main.js
aetheria/index-main.css
aetheria/play.html
aetheria/root.html
aetheria/headers_*.txt
aetheria/scan*.txt

# ── OS / editor cruft ───────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
~$*

# ── VS Code — ignore local state, keep shared configs ───────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
